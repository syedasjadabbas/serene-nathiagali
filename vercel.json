{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [{ "source": "/", "destination": "/serene-heights-nathiagali", "permanent": false }],
  "rewrites": [
    { "source": "/robots.txt", "destination": "/serene-heights-nathiagali/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/serene-heights-nathiagali/sitemap.xml" },
    { "source": "/serene-heights-nathiagali", "destination": "/serene-heights-nathiagali/index.html" },
    { "source": "/serene-heights-nathiagali/((?!assets/|data/).*)", "destination": "/serene-heights-nathiagali/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/serene-heights-nathiagali/assets/:file([^/]+\\.(?:js|css|woff2))",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/serene-heights-nathiagali/(assets/(?:film2|hero5|img|map|model|video)|data)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    }
  ]
}
